#!/usr/bin/env bash
# 合成整個 sch001.g0v.tw 網站並以單一 orphan commit force push 到 $DEPLOY_BRANCH ( 預設 gh-pages ):
#  - /       : sch001-net/static ( submodule, 已建置的靜態站 )
#  - /dash/  : web/static ( 提案典藏 full build, 取代原 grantdash )
# 該分支永遠只有一個 commit. 遠端更新方式見 README.
set -e
BRANCH=${DEPLOY_BRANCH:-gh-pages}
if [[ ! -d .git ]]; then
  echo "please use deploy under a git repo."
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "working tree not clean. commit first so the deploy maps to a commit."
  exit 1
fi
git submodule update --init
REMOTE=`git remote get-url origin`
REV=`git rev-parse --short HEAD`
NETREV=`git -C sch001-net rev-parse --short HEAD`
rm -rf web/static _public
npm run build
mkdir -p _public/dash
# sch001-net 的 CNAME 屬於其 GitHub Pages 鏡像 ( sch001.g0v.dev ), 不帶過來
rsync -a --exclude .gitignore --exclude CNAME sch001-net/static/ _public/
rsync -a web/static/ _public/dash/
cd _public
git init -q -b "$BRANCH"
git add -A
git commit -q -m "build from $REV ( sch001-net $NETREV )"
git push --force "$REMOTE" "$BRANCH"
cd ..
rm -rf _public
